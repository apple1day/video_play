<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PlayerTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    
    <!-- 自定义播放器控制器样式 - 去掉背景遮罩 -->
    <style name="TransparentPlayerControlView" parent="Widget.AppCompat.ActionButton">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- 底部导航 Tab 文字样式 -->
    <style name="BottomTabTextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>

