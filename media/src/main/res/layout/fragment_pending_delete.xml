<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_surface_container">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/md_surface"
        android:elevation="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="待删除"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:id="@+id/count_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="暂无待删除视频"
                    android:textSize="12sp"
                    android:textColor="@color/md_on_surface_hint"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <Button
                android:id="@+id/delete_all_button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="全部删除"
                android:textSize="13sp"
                android:textColor="@color/md_on_error"
                android:background="@drawable/btn_delete_red"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:enabled="false"
                android:alpha="0.5"
                style="@android:style/Widget.Material.Button.Borderless" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="长按视频可取消标记或立即删除"
            android:textSize="11sp"
            android:textColor="@color/md_on_surface_hint"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑️"
            android:textSize="52sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂无待删除视频"
            android:textSize="16sp"
            android:textColor="@color/md_on_surface_hint"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="在播放器中标记视频后会显示在这里"
            android:textSize="13sp"
            android:textColor="@color/md_on_surface_muted"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:visibility="gone" />

</LinearLayout>
