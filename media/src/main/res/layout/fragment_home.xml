<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 顶部搜索栏 - 现代化卡片风格 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical">

        <!-- 搜索框 -->
        <SearchView
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="10dp"
            android:iconifiedByDefault="false"
            android:queryHint="搜索视频文件名..."
            android:background="@drawable/search_bg" />

        <!-- 工具栏区域 -->
        <LinearLayout
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <!-- 第一行：存储选择 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/storage_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/storage_label"
                    android:textSize="13sp"
                    android:textColor="#616161"
                    android:layout_marginEnd="6dp" />

                <Spinner
                    android:id="@+id/storage_spinner"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:minWidth="100dp"
                    android:background="@drawable/spinner_bg" />

            </LinearLayout>

            <!-- 第二行：排序、筛选、视图切换按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/sort_time_button"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="时间↓"
                    android:textSize="11sp"
                    android:textColor="#424242"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minWidth="0dp"
                    android:background="@drawable/btn_filter_normal"
                    android:layout_marginEnd="3dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <Button
                    android:id="@+id/sort_size_button"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="大小↓"
                    android:textSize="11sp"
                    android:textColor="#424242"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minWidth="0dp"
                    android:background="@drawable/btn_filter_normal"
                    android:layout_marginEnd="3dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <Button
                    android:id="@+id/filter_watched_button"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="已看"
                    android:textSize="11sp"
                    android:textColor="#424242"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minWidth="0dp"
                    android:background="@drawable/btn_filter_normal"
                    android:layout_marginEnd="3dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <Button
                    android:id="@+id/filter_unwatched_button"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="未看"
                    android:textSize="11sp"
                    android:textColor="#424242"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minWidth="0dp"
                    android:background="@drawable/btn_filter_normal"
                    android:layout_marginEnd="3dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <Button
                    android:id="@+id/view_toggle_button"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="网格"
                    android:textSize="11sp"
                    android:textColor="#424242"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minWidth="0dp"
                    android:background="@drawable/btn_filter_normal"
                    android:layout_marginEnd="3dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <Button
                    android:id="@+id/smart_filter_button"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="筛选"
                    android:textSize="11sp"
                    android:textColor="#424242"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minWidth="0dp"
                    android:background="@drawable/btn_filter_normal"
                    android:layout_marginEnd="3dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <Button
                    android:id="@+id/delete_all_pending_button"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1.2"
                    android:text="删全部"
                    android:textSize="11sp"
                    android:textColor="#D32F2F"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:minWidth="0dp"
                    android:background="@drawable/btn_filter_delete"
                    style="@android:style/Widget.Material.Button.Borderless" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 多选操作栏（默认隐藏） -->
    <LinearLayout
        android:id="@+id/selection_toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <!-- 第一行：选择按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/select_all_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/select_all"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/select_favorites_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/select_all_favorites"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/select_watched_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/select_watched"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/select_pending_deletes_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_pending_deletes"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@android:style/Widget.Material.Button.Borderless" />

        </LinearLayout>

        <!-- 第二行：操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/selected_count_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/selected_count"
                android:textSize="12sp"
                android:textColor="#424242"
                android:gravity="start" />

            <Button
                android:id="@+id/delete_selected_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/delete_selected"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@android:color/holo_red_dark"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/cancel_selection_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel_selection"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@android:style/Widget.Material.Button.Borderless" />

        </LinearLayout>

    </LinearLayout>

    <!-- 内容区域 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="6dp"
                android:paddingBottom="50dp" />

            <TextView
                android:id="@+id/empty_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/no_files"
                android:textSize="16sp"
                android:textColor="#9E9E9E"
                android:visibility="gone" />

            <TextView
                android:id="@+id/loading_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="正在扫描视频..."
                android:textSize="16sp"
                android:textColor="#757575"
                android:visibility="gone" />

            <TextView
                android:id="@+id/loading_more_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:padding="16dp"
                android:text="加载中..."
                android:textSize="13sp"
                android:textColor="#9E9E9E"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
