<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- 顶部 Header 区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <!-- 标题 + 搜索框 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="小熊播放器"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:letterSpacing="0.01" />

            <!-- 存储切换按钮（已隐藏：主页现在统一扫描所有存储设备；存储切换迁移到"文件夹"Tab） -->
            <Spinner
                android:id="@+id/storage_spinner"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="80dp"
                android:visibility="gone"
                android:background="@drawable/spinner_bg_modern" />

        </LinearLayout>

        <!-- 搜索框 -->
        <SearchView
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:iconifiedByDefault="false"
            android:queryHint="搜索视频..."
            android:background="@drawable/search_bg_modern" />

        <!-- 工具栏区域（正常状态） -->
        <HorizontalScrollView
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:scrollbars="none"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/sort_time_button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="时间"
                    android:textSize="12sp"
                    android:textColor="#FF6B35"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minWidth="0dp"
                    android:background="@drawable/chip_active"
                    android:layout_marginEnd="8dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <Button
                    android:id="@+id/sort_size_button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="大小"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minWidth="0dp"
                    android:background="@drawable/chip_normal"
                    android:layout_marginEnd="8dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:background="#E0E0E0"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/filter_watched_button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="已看"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minWidth="0dp"
                    android:background="@drawable/chip_normal"
                    android:layout_marginEnd="8dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <Button
                    android:id="@+id/filter_unwatched_button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="未看"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minWidth="0dp"
                    android:background="@drawable/chip_normal"
                    android:layout_marginEnd="8dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:background="#E0E0E0"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/view_toggle_button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="网格"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minWidth="0dp"
                    android:background="@drawable/chip_normal"
                    android:layout_marginEnd="8dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <Button
                    android:id="@+id/smart_filter_button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="筛选"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minWidth="0dp"
                    android:background="@drawable/chip_normal"
                    android:layout_marginEnd="8dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <Button
                    android:id="@+id/delete_all_pending_button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="清除待删"
                    android:textSize="12sp"
                    android:textColor="#E53935"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minWidth="0dp"
                    android:background="@drawable/chip_danger"
                    style="@android:style/Widget.Material.Button.Borderless" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- 多选操作栏（默认隐藏） -->
    <LinearLayout
        android:id="@+id/selection_toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <!-- 选择类型按钮行 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:scrollbars="none"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/select_all_button"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="全选"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/chip_normal"
                    android:layout_marginEnd="8dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <Button
                    android:id="@+id/select_favorites_button"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="选收藏"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/chip_normal"
                    android:layout_marginEnd="8dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <Button
                    android:id="@+id/select_watched_button"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="选已看"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/chip_normal"
                    android:layout_marginEnd="8dp"
                    style="@android:style/Widget.Material.Button.Borderless" />

                <Button
                    android:id="@+id/select_pending_deletes_button"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="选待删"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/chip_normal"
                    style="@android:style/Widget.Material.Button.Borderless" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- 操作按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/selected_count_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="已选择 0 项"
                android:textSize="13sp"
                android:textColor="#FF6B35"
                android:textStyle="bold" />

            <Button
                android:id="@+id/delete_selected_button"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="删除"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:minWidth="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/btn_delete_red"
                android:layout_marginEnd="8dp"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/cancel_selection_button"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="取消"
                android:textSize="13sp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/chip_normal"
                style="@android:style/Widget.Material.Button.Borderless" />

        </LinearLayout>

    </LinearLayout>

    <!-- 内容区域 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

            <!-- 空状态 -->
            <LinearLayout
                android:id="@+id/empty_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📭"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="没有找到视频文件"
                    android:textSize="16sp"
                    android:textColor="#BDBDBD"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- 加载中 -->
            <LinearLayout
                android:id="@+id/loading_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="#FF6B35" />

                <TextView
                    android:id="@+id/loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正在扫描视频..."
                    android:textSize="14sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- 底部加载更多 -->
            <TextView
                android:id="@+id/loading_more_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:padding="12dp"
                android:text="加载中..."
                android:textSize="12sp"
                android:textColor="#BDBDBD"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
