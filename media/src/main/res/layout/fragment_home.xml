<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 搜索框 -->
    <SearchView
        android:id="@+id/search_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:iconifiedByDefault="false"
        android:queryHint="搜索视频..."
        android:background="@android:drawable/edit_text" />

    <!-- 工具栏区域 - 使用垂直布局支持多行 -->
    <LinearLayout
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_marginTop="8dp">

        <!-- 第一行：存储选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/storage_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/storage_label"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <Spinner
                android:id="@+id/storage_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="100dp" />

        </LinearLayout>

        <!-- 第二行：排序和视图切换按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/sort_time_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="时间"
                android:textSize="11sp"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:drawablePadding="1dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:minWidth="0dp"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/sort_size_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="大小"
                android:textSize="11sp"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:drawablePadding="1dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:minWidth="0dp"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/filter_watched_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="已看"
                android:textSize="11sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:minWidth="0dp"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/filter_unwatched_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="未看"
                android:textSize="11sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:minWidth="0dp"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/view_toggle_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="网格"
                android:textSize="11sp"
                android:drawablePadding="1dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:minWidth="0dp"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/smart_filter_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="筛选"
                android:textSize="11sp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:minWidth="0dp"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/delete_all_pending_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="删全部"
                android:textSize="11sp"
                android:textColor="@android:color/holo_red_dark"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:minWidth="0dp"
                style="@android:style/Widget.Material.Button.Borderless" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/selection_toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:background="@android:color/white">

        <!-- 第一行：选择按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/select_all_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/select_all"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/select_favorites_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/select_all_favorites"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/select_watched_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/select_watched"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/select_pending_deletes_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_pending_deletes"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@android:style/Widget.Material.Button.Borderless" />

        </LinearLayout>

        <!-- 第二行：操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/selected_count_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/selected_count"
                android:textSize="12sp"
                android:gravity="start" />

            <Button
                android:id="@+id/delete_selected_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/delete_selected"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@android:color/holo_red_dark"
                style="@android:style/Widget.Material.Button.Borderless" />

            <Button
                android:id="@+id/cancel_selection_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel_selection"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                style="@android:style/Widget.Material.Button.Borderless" />

        </LinearLayout>

    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="8dp"
                android:paddingBottom="50dp" />

            <TextView
                android:id="@+id/empty_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/no_files"
                android:visibility="gone" />

            <TextView
                android:id="@+id/loading_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="正在扫描视频..."
                android:textSize="16sp"
                android:visibility="gone" />
            
            <TextView
                android:id="@+id/loading_more_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:padding="16dp"
                android:text="加载中..."
                android:textSize="14sp"
                android:textColor="#999999"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>

