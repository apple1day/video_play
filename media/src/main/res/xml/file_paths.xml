<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 路径配置 - 定义应用可以共享的文件目录 -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 应用内部存储 - 相当于 iOS 的 Documents 目录 -->
    <files-path 
        name="internal_files" 
        path="." />
    
    <!-- 应用缓存目录 -->
    <cache-path 
        name="cache_files" 
        path="." />
    
    <!-- 外部存储私有目录 - 应用专属文件 -->
    <external-files-path 
        name="external_files" 
        path="." />
    
    <!-- 外部存储私有缓存 -->
    <external-cache-path 
        name="external_cache" 
        path="." />
    
    <!-- 外部存储根目录（需要权限） -->
    <external-path 
        name="external_storage" 
        path="." />
    
    <!-- Movies 目录 - 用于视频文件 -->
    <external-files-path 
        name="movies" 
        path="Movies/" />
    
    <!-- Downloads 目录 -->
    <external-files-path 
        name="downloads" 
        path="Download/" />
    
    <!-- 自定义视频目录 -->
    <external-files-path 
        name="videos" 
        path="Videos/" />
    
</paths>
